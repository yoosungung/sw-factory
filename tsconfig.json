{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "vite/client"],
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": {
      "@backend/*": ["./backend/src/*"]
    }
  },
  "include": ["backend/**/*.ts", "frontend/**/*.ts", "frontend/**/*.tsx", "vitest.config.ts"]
}
