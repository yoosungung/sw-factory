{
  "name": "sw-factory-workers",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "local:run": "./scripts/run-local.sh",
    "local:stop": "./scripts/stop-local.sh",
    "local:run:remote-ticket": "./scripts/run-local.sh remote-ticket",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run && vitest run --config agent/vitest.config.ts && vitest run --config frontend/vitest.config.ts",
    "test:agent": "vitest run --config agent/vitest.config.ts",
    "agent:gateway": "tsx agent/gateway/src/cli.ts",
    "agent:cursor": "tsx agent/cursor/src/cli.ts",
    "test:watch": "vitest",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=\"${PLAYWRIGHT_BROWSERS_PATH:-$HOME/Library/Caches/ms-playwright}\" playwright test -c e2e/playwright.config.ts",
    "test:e2e:headed": "PLAYWRIGHT_BROWSERS_PATH=\"${PLAYWRIGHT_BROWSERS_PATH:-$HOME/Library/Caches/ms-playwright}\" playwright test -c e2e/playwright.config.ts --headed",
    "test:e2e:ui": "PLAYWRIGHT_BROWSERS_PATH=\"${PLAYWRIGHT_BROWSERS_PATH:-$HOME/Library/Caches/ms-playwright}\" playwright test -c e2e/playwright.config.ts --ui",
    "test:e2e:install": "PLAYWRIGHT_BROWSERS_PATH=\"${PLAYWRIGHT_BROWSERS_PATH:-$HOME/Library/Caches/ms-playwright}\" playwright install chromium",
    "db:migrate:local": "wrangler d1 migrations apply sw-factory --local",
    "deploy": "npm run build && wrangler d1 migrations apply sw-factory --remote && wrangler deploy -c dist/sw_factory_workers/wrangler.json"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.31",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.7.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.2.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@cloudflare/workers-types": "^4.20250906.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "~3.2.0",
    "wrangler": "4.35.0"
  }
}
