# Copy to agents.yaml and fill with real identities (gitignored).
#   cp deploy/k8s/agents.yaml.sample deploy/k8s/agents.yaml
# Then: ./deploy/k8s/scripts/render-agents.sh && python deploy/k8s/scripts/sync-bridge-json.py
#
# M11: clients[] ≡ Leantime client_id. repos[] + optional tenant_cd.
# Factory staff (pm/km/ta/qa/aa) are not bound to a client.
# Developers (human|sessions) bind via primary_repo under a client.

clients:
  - id: demo-acme
    leantime_client_id: 1
    project_id: 1
    repo_ids: [landing-web, shop-api]

  # Example real client (see deploy/SETUP.md §B)
  - id: sw-factory
    leantime_client_id: 2
    project_id: 5
    repo_ids: [sw-factory]

  - id: nl2sql
    leantime_client_id: 3
    project_id: 6
    repo_ids: [nl2sql]

repos:
  - id: bridge-harness
    git_repo_url: https://github.com/demo-org/bridge-harness.git

  - id: sw-factory
    git_repo_url: https://github.com/yoosungung/sw-factory.git

  - id: nl2sql
    git_repo_url: https://github.com/yoosungung/nl2sql.git

  - id: shop-api
    git_repo_url: https://github.com/demo-org/shop-api.git

  - id: landing-web
    git_repo_url: https://github.com/demo-org/landing-web.git
    # Tenant CD: registry key = clients[].leantime_client_id + repo_id
    tenant_cd:
      enabled: true
      driver: workflow_dispatch
      workflow: deploy.yml
      ref: main
      inputs:
        environment: test
      image_input: image_tag
      verify:
        namespace: landing
        deployment: web
        timeout_sec: 300
        smoke:
          type: http
          url: http://web.landing.svc.cluster.local:8080/healthz
          expect_status: 200

  - id: topology-lib
    git_repo_url: https://github.com/demo-org/topology-lib.git

  - id: org-wiki
    git_repo_url: https://github.com/demo-org/org-wiki.git

  - id: k8s-test
    git_repo_url: https://github.com/demo-org/k8s-test.git

agents:
  - name: eric
    leantime_user_id: 1
    email: eric@example.com
    persona: eric
    primary_repo: bridge-harness
    type: human

  # Factory staff (PM) — cross-client
  - name: pm
    leantime_user_id: 4
    email: pm@example.com
    persona: pm
    primary_repo: shop-api
    type: sessions
    gh_token_secret_key: GH_TOKEN_pm

  # Example developer agent (sessions) — yoosungung/sw-factory client repo
  - name: sw-factory
    leantime_user_id: 7
    email: sw-factory@example.com
    persona: sw-factory
    primary_repo: sw-factory
    type: sessions

  - name: nl2sql
    leantime_user_id: 8
    email: nl2sql@example.com
    persona: nl2sql
    primary_repo: nl2sql
    type: sessions

  # Example developer agent (sessions) — repo under client
  - name: asky
    leantime_user_id: 5
    email: asky@example.com
    persona: asky
    primary_repo: landing-web
    type: sessions

  - name: path
    leantime_user_id: 6
    email: path@example.com
    persona: path
    primary_repo: topology-lib
    type: sessions

  # Factory staff (TA)
  - name: ta
    leantime_user_id: 13
    email: ta@example.com
    persona: ta
    primary_repo: k8s-test
    type: sessions

  # Factory staff (KM)
  - name: km
    leantime_user_id: 9
    email: km@example.com
    persona: km
    primary_repo: org-wiki
    type: sessions

  # Factory staff (QA)
  - name: qa
    leantime_user_id: 15
    email: qa@example.com
    persona: qa
    primary_repo: bridge-harness
    type: sessions

  # Factory staff (AA)
  - name: aa
    leantime_user_id: 16
    email: aa@example.com
    persona: aa
    primary_repo: bridge-harness
    type: sessions

settings:
  debounce_ms: 3000
  mention_routing: true
  replicas_max: 10
  runner_image: ghcr.io/example/agent-runner:latest
  model: auto
  # Soft-factory NS (override for leantime NS demos)
  k8s_namespace: sw-factory
  leantime_url: http://leantime.sw-factory.svc
  # Dual-loop board: configure same names/ids on each client Leantime project
  status_board:
    New: 3
    Blocked: 1
    In Progress: 4
    Waiting for Approval: 2
    Review: 10
    Deploying Test: 11
    QA: 12
    Deploying Prod: 13
    Done: 0
  budget:
    timeout_ms: 600000
  success_retry:
    max_attempts: 3
  success_checks:
    - "Read Active ticket via Leantime MCP before writing."
    - "Leave an add_comment outcome on the Active ticket."
    - "If Review-ready: git-ship (push + PR) before handoff."
    - "If tenant_cd-enabled: feature Done needs test+qa+aa+prod evidence (ARCHITECTURE §2.8)."
    - "Wiki-first (org-knowledge); after work: inbox path or wiki: N/A on Active ticket."
  schedules:
    - id: pm-checkpoint
      cron: "5,20,35,50 * * * *"
      agents: [pm]
      gates: [in_progress]
      prompt: >-
        Use the leantime-pm skill. 30분 체크포인트. In Progress 개발 티켓만.
        Dual-loop: Review→Deploying Test→QA→Deploying Prod→Done.
        Done는 test+qa+aa+prod 증거 있을 때만. 멘션 id: eric=1,pm=4,asky=5,path=6,km=9,ta=13,qa=15,aa=16.
        실행당 코멘트 ≤5.
      success_checks:
        - "At most 5 checkpoint comments added this run."
        - "No duplicate PM checkpoint within 30 minutes on the same ticket."
        - "Final reply lists acted/skipped tickets with classification."
    - id: github-issue-check
      cron: "0 23 * * *"
      prompt: >-
        github issue 점검하여 신규는 티켓으로 변환하고, 블로커가 있으면 add_comment 처리.
        QA가 재현·시나리오 등록할 수 있게 client 프로젝트에 둔다.
      success_checks:
        - "New GitHub issues are reflected as Leantime tickets or explicitly skipped with a comment."
        - "Blockers are reported via add_comment."
    - id: km-wiki
      cron: "30 23 * * *"
      agents: [km]
      prompt: >-
        Use km-researcher then knowledge-promote as needed.
        Inbox drain + wiki research ingest; commit·push directly to default branch(main).
        PR·feature branch·git-ship 금지. 실패 시 ticket(New), 성공 시 ticket(Done).
      success_checks:
        - "Changes are committed and pushed directly to the default branch (no PR)."
        - "Do not run git-ship or gh pr create."
        - "Inbox drain attempted (or explicitly no pending inbox)."
        - "On success create/update a Done ticket; on failure a New ticket with blocker."
    - id: ta-k8s-daily
      cron: "0 1 * * *"
      agents: [ta]
      prompt: >-
        Use the k8s-operator-operations skill. 일일 k8s 운영 리포트(read-only).
        mutate/배포 금지. 조치 가능 장애는 incident-tickets.md대로 client 프로젝트 티켓.
      success_checks:
        - "Report uses the k8s 운영 리포트 format with a clear status summary."
        - "No mutating kubectl actions in this scheduled run."
        - "Actionable incidents are ticketed or explicitly listed as none."
    - id: ta-load-weekly
      cron: "0 2 * * 1"
      agents: [ta]
      prompt: >-
        Use load-weekly skill. For each clients[] entry, run tenant .factory/quality.yaml load
        commands against test env. Failures → New ticket in that client's project_id.
        Do not mark feature tickets Done from this run.
      success_checks:
        - "Each client load was run or explicitly skipped with reason."
        - "Failures created New tickets in the correct client project."
    - id: aa-clean-weekly
      cron: "30 2 * * 1"
      agents: [aa]
      prompt: >-
        Use clean-code-weekly skill. For each client repo, run tenant clean_code checks.
        Findings → New ticket in client project_id. Not a prod gate for feature tickets.
      success_checks:
        - "Each client clean-code check ran or was skipped with reason."
        - "Findings filed as New tickets on the client project."
    - id: qa-bulk-weekly
      cron: "0 3 * * 1"
      agents: [qa]
      prompt: >-
        Use bulk-api-probe and opik-eval as configured in tenant .factory/quality.yaml.
        Weekly bulk quality across clients. Failures → New tickets on client project_id.
      success_checks:
        - "Bulk/Opik suites ran per tenant config or skipped with reason."
        - "Failures filed as New tickets on the client project."
    - id: seewin-people-curation
      cron: "0 9 * * *"
      agents: [seewin]
      prompt: >-
        Use political-wiki-administration in /workspace/repo. People SSoT curation (18:00 KST).
        Report on Leantime project 20 as user 14. main direct push only after validation.
      success_checks:
        - "Work stayed in /workspace/repo."
        - "Leantime report as seewin (user 14) or blocked with reason."
    - id: seewin-publication-review
      cron: "0 18 * * *"
      agents: [seewin]
      prompt: >-
        Use political-wiki-administration in /workspace/repo. Publication-safety review (03:00 KST).
        Run publication_gate.py before push. Report project 20 user 14.
      success_checks:
        - "publication_gate.py run before push decision."
        - "Leantime report as seewin (user 14)."
    - id: seewin-issue-radar-today
      cron: "0 23 * * *"
      agents: [seewin]
      prompt: >-
        Use political-wiki-administration in /workspace/repo. Issue radar → wiki/data/today.yaml.
        No Leantime tickets. Direct main push when changed.
      success_checks:
        - "No new Leantime ticket."
        - "Only wiki/data/today.yaml committed when changed, or no-op."
