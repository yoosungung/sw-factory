# Copy to agents.yaml and fill with real identities (gitignored).
#   cp deploy/k8s/agents.yaml.sample deploy/k8s/agents.yaml
# Then: ./deploy/k8s/scripts/render-agents.sh && python deploy/k8s/scripts/sync-bridge-json.py
#
# M11: clients[] ≡ Leantime client_id. repos[] + optional tenant_cd.
# Factory staff (pm/km/ta/qa/aa) are not bound to a client.
# Developers (human|sessions) bind via primary_repo under a client.
#
# Git policy: commit only demo-* placeholders here. Real tenants (client ids,
# repo URLs, developer agents, personas) live in local agents.yaml / docs/ only.

clients:
  - id: demo-acme
    leantime_client_id: 1
    project_id: 1
    repo_ids: [landing-web, shop-api]

repos:
  - id: bridge-harness
    git_repo_url: https://github.com/demo-org/bridge-harness.git

  - id: shop-api
    git_repo_url: https://github.com/demo-org/shop-api.git

  - id: landing-web
    git_repo_url: https://github.com/demo-org/landing-web.git
    # Optional: PM syncs ROADMAP.md → Leantime (one current milestone at a time)
    roadmap:
      enabled: true
      path: ROADMAP.md
    # Tenant CD: registry key = clients[].leantime_client_id + repo_id
    tenant_cd:
      enabled: true
      driver: workflow_dispatch
      workflow: deploy.yml
      ref: main
      inputs:
        environment: test
      image_input: image_tag
      verify:
        namespace: landing
        deployment: web
        timeout_sec: 300
        smoke:
          type: http
          url: http://web.landing.svc.cluster.local:8080/healthz
          expect_status: 200

  - id: topology-lib
    git_repo_url: https://github.com/demo-org/topology-lib.git

  - id: org-wiki
    git_repo_url: https://github.com/demo-org/org-wiki.git

  - id: k8s-test
    git_repo_url: https://github.com/demo-org/k8s-test.git

agents:
  - name: eric
    leantime_user_id: 1
    email: eric@example.com
    persona: eric
    primary_repo: bridge-harness
    type: human

  # Factory staff — soft-factory sequential ids: pm=2…aa=6 (seed rewrites on install)
  - name: pm
    leantime_user_id: 2
    email: pm@example.com
    persona: pm
    primary_repo: shop-api
    type: sessions
    gh_token_secret_key: GH_TOKEN_pm

  # Demo-only developer agents — placeholder ids (remap / replace in local agents.yaml)
  - name: asky
    leantime_user_id: 101
    email: asky@example.com
    persona: asky
    primary_repo: landing-web
    type: sessions

  - name: path
    leantime_user_id: 102
    email: path@example.com
    persona: path
    primary_repo: topology-lib
    type: sessions

  - name: ta
    leantime_user_id: 4
    email: ta@example.com
    persona: ta
    primary_repo: k8s-test
    type: sessions
    gh_token_secret_key: GH_TOKEN_ta

  - name: km
    leantime_user_id: 3
    email: km@example.com
    persona: km
    primary_repo: org-wiki
    type: sessions

  - name: qa
    leantime_user_id: 5
    email: qa@example.com
    persona: qa
    primary_repo: bridge-harness
    type: sessions

  - name: aa
    leantime_user_id: 6
    email: aa@example.com
    persona: aa
    primary_repo: bridge-harness
    type: sessions

settings:
  debounce_ms: 3000
  mention_routing: true
  replicas_max: 10
  runner_image: ghcr.io/example/agent-runner:latest
  model: auto
  # Soft-factory NS (override for leantime NS demos)
  k8s_namespace: sw-factory
  leantime_url: http://leantime.sw-factory.svc
  # Dual-loop board: configure same names/ids on each client Leantime project
  status_board:
    New: 3
    Blocked: 1
    In Progress: 4
    Waiting for Approval: 2
    Review: 10
    Deploying Test: 11
    QA: 12
    Deploying Prod: 13
    Done: 0
  budget:
    timeout_ms: 600000
  success_retry:
    max_attempts: 3
  success_checks:
    - "Read Active ticket via Leantime MCP before writing."
    - "Leave an add_comment outcome on the Active ticket."
    - "If Review-ready: git-ship (push + PR) before handoff."
    - "If tenant_cd-enabled: feature Done needs test+qa+aa+prod evidence (ARCHITECTURE §2.8)."
    - "Wiki-first (org-knowledge); after work: inbox path or wiki: N/A on Active ticket."
  schedules:
    - id: pm-checkpoint
      cron: "5,20,35,50 * * * *"
      agents: [pm]
      gates: [flow_active]
      prompt: >-
        Use the leantime-pm skill. Dual-loop flow checkpoint (ARCHITECTURE §2.6 #15 closed-loop).
        Scan In Progress + Review + Deploying Test + QA + Deploying Prod.
        Silence clock: only assignee progress / nf-progress / completion·blocker (not ladder @mentions,
        status-board, or mention-outcome seals).
        In Progress: 30m timebox; after 3 empty checkpoints → Waiting for Approval + admin human.
        Review: PM review/merge (no self-nudge); ≥2h no PM evidence → Approval + admin once.
        Deploy/QA ladder: ≥2h silence → assignee health-check once; ≥1h after HC with no assignee evidence →
        if assignee=ta skip ARC (dead-by-timeout) else @ta assignee-runtime-check once (Pod/runner logs only;
        no EX/E2E/security/CD; never re-nudge ARC). TA Outcome Verdict alive|dead within 1h → resume or
        restart/Blocked; no Outcome ≥1h → dead-by-timeout. Cycle cap=1 then terminal Approval + admin
        (type:human from bridge; never hardcode ids).
        Mention/comment storm: lookback last 2h or newest 30 comments; with no silence-reset, if factory-agent
        mutual @mentions ≥8 OR mention-outcome/delegated_from/remediator seals ≥12 → immediate terminal
        Approval+admin (ask states loop evidence; no further agent @mention).
        Status board: one `<!-- pm-checkpoint-status -->`
        per ticket; upsert ladder_rung/ladder_cycle/arc_comment_id/hc_at via edit_comment (no @mentions in board).
        New add_comment only for actionable @mentions/misroute/terminal. Never "PM verify" / "Outcome record only".
        No kubectl/E2E/security/re-run by pm. Dual-loop Done needs test+qa+aa+prod evidence.
        Mentions: resolve each name via bridge.json `leantime_user_id`. ≤5 new actionable comments/run.
      success_checks:
        - "At most 5 new actionable add_comment this run (status-board edit_comment excluded)."
        - "No-op/SLA updates use edit_comment on <!-- pm-checkpoint-status --> (no new verify spam)."
        - "Final reply lists acted/skipped tickets with classification."
    - id: pm-roadmap-sync
      cron: "0 22 * * *"
      agents: [pm]
      prompt: >-
        Use the leantime-pm skill and references/roadmap-sync.md.
        Read .cursor/roadmap-registry.json. For each enabled repo, sync ROADMAP:
        one current milestone only (first ## section with unchecked - [ ] items);
        do not enqueue later ## milestones while current is open.
        If no incomplete ##: create/reuse pass-gate ticket; delegate to ta|qa|aa or
        client/admin human (type:human from bridge/agents — never hardcode eric);
        only after assignee comment <!-- roadmap-pass:approved --> create next ###
        milestone parent ticket (next = least M{id} strictly greater than passed, e.g. M2→M3;
        not first ### in document order). Dedup with <!-- roadmap:repo_id:… --> markers.
      success_checks:
        - "Only current incomplete ## tickets OR (pass-gate handoff) OR (approved next ### parent) this run."
        - "Final reply lists per-repo current / pass-gate assignee / approved→next, created/skipped counts."
    - id: github-issue-check
      cron: "0 23 * * *"
      prompt: >-
        github issue 점검하여 신규는 티켓으로 변환하고, 블로커가 있으면 add_comment 처리.
        QA가 재현·시나리오 등록할 수 있게 client 프로젝트에 둔다.
      success_checks:
        - "New GitHub issues are reflected as Leantime tickets or explicitly skipped with a comment."
        - "Blockers are reported via add_comment."
    - id: km-wiki
      cron: "30 23 * * *"
      agents: [km]
      prompt: >-
        Use km-researcher then knowledge-promote as needed.
        Inbox drain + wiki research ingest; commit·push directly to default branch(main).
        PR·feature branch·git-ship 금지. 실패 시 ticket(New), 성공 시 ticket(Done).
      success_checks:
        - "Changes are committed and pushed directly to the default branch (no PR)."
        - "Do not run git-ship or gh pr create."
        - "Inbox drain attempted (or explicitly no pending inbox)."
        - "On success create/update a Done ticket; on failure a New ticket with blocker."
    - id: ta-k8s-daily
      cron: "0 1 * * *"
      agents: [ta]
      prompt: >-
        Use the k8s-operator-operations skill. 일일 k8s 운영 리포트(read-only).
        mutate/배포 금지. 조치 가능 장애는 incident-tickets.md대로 client 프로젝트 티켓.
      success_checks:
        - "Report uses the k8s 운영 리포트 format with a clear status summary."
        - "No mutating kubectl actions in this scheduled run."
        - "Actionable incidents are ticketed or explicitly listed as none."
    - id: ta-load-weekly
      cron: "0 2 * * 1"
      agents: [ta]
      prompt: >-
        Use tenant-repo-sync then load-weekly. For each clients-repos-registry entry,
        sync product repo, then run tenant .factory/quality.yaml load against test env.
        Failures → New ticket in that client's project_id.
        Do not mark feature tickets Done from this run.
        Long-run load: detach + nf-progress heartbeats (ARCHITECTURE §2.6 #10).
      success_checks:
        - "Each client repo has synced: evidence (sha+path) or an explicit skip reason."
        - "Each client load was run or explicitly skipped with reason."
        - "Failures created New tickets in the correct client project."
    - id: aa-clean-weekly
      cron: "30 2 * * 1"
      agents: [aa]
      prompt: >-
        Use tenant-repo-sync then clean-code-weekly. For each client repo: sync, read
        .factory/quality.yaml clean_code criteria (command, focus/exclude, max_findings);
        run mechanical command; then Clean Code heuristic review per skill references.
        High/Med findings → New tickets on client project_id
        (structured smell_id + impact; not lint paste alone). Not a prod gate; not security-review.
        Long-run mechanical: detach + nf-progress (ARCHITECTURE §2.6 #10).
      success_checks:
        - "Each client repo has synced: evidence (sha+path) or an explicit skip reason."
        - "Each client ran clean_code.command or was skipped with reason."
        - "Heuristic review summarized per client (or partial with reason)."
        - "High/Med findings filed as New tickets on the client project, or no High/Med recorded."
    - id: qa-bulk-weekly
      cron: "0 3 * * 1"
      agents: [qa]
      prompt: >-
        Use tenant-repo-sync then bulk-api-probe and opik-eval as configured in
        tenant .factory/quality.yaml. Weekly bulk quality across clients.
        Failures → New tickets on client project_id.
        Long Opik/EX: detach + nf-progress (ARCHITECTURE §2.6 #10).
      success_checks:
        - "Each client repo has synced: evidence (sha+path) or an explicit skip reason."
        - "Bulk/Opik suites ran per tenant config or skipped with reason."
        - "Failures filed as New tickets on the client project."
