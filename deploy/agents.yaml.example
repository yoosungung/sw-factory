# Local / ConfigMap sample. Copy to ../agents.yaml & edit.
# user_id = factory users.id (UUID). Create bots:
#   cd deploy/local && set PERSONA_PASSWORD in .env && ./register-agent-users.sh
# See local/README.md «Agent user_id 등록».
# type: sessions — gateway delivery targets.
# repos[] catalog + agent primary_repo / repo_ids → seed ensure (clone-if-missing).
# pm.roadmaps[] → roadmap-registry.json; ta.tenant_cd[] → tenant-cd-registry.json
# (verify overlay: deploy/personas/ta/.cursor/tenant-cd-verify.json; dispatch: tenant .factory/cd.yaml).

factory_base_url: https://factory.example.com

settings:
  model: auto
  debounce_ms: 2000
  pool_size: 2
  max_active_per_persona: 1
  max_queue_per_persona: 32
  cursor_listen: 127.0.0.1:8080
  poll_interval_ms: 3000
  success_checks:
    - Read Active ticket via factory-mcp before writing.
    - Leave an add_comment outcome on the Active ticket when work progressed.
    - "If Review-ready: git-ship (push + PR) before handoff."
    - "If tenant_cd-enabled: feature Done needs test+qa+aa+prod evidence (skill gate)."
    - "Wiki-first (org-knowledge); after work: inbox path or wiki: N/A on Active ticket."
  schedules:
    - id: pm-checkpoint
      cron: "5,20,35,50 * * * *"
      agents: [pm]
      gates: [flow_active]
      prompt: >-
        Use factory-pm. Dual-loop flow checkpoint. Scan in_progress, review,
        deploying_test, qa, deploying_prod. Silence clock: assignee progress /
        nf-progress: / completion·blocker only. In Progress ≈30m × 3 empty →
        waiting_for_approval + @admin. Review ≥2h no pm evidence → Approval.
        Deploy/QA ladder as factory-pm ticket-ops. Status board:
        <!-- pm-checkpoint-status --> upsert via edit_comment; actionable
        add_comment only. No kubectl/E2E/security/CD by pm. ≤5 actionable comments.
      success_checks:
        - At most 5 new actionable add_comment this run (status-board edit_comment excluded).
        - Final reply lists acted/skipped tickets with classification.
    - id: pm-roadmap-sync
      cron: "0 22 * * *"
      agents: [pm]
      prompt: >-
        Use factory-pm roadmap-sync. Read .cursor/roadmap-registry.json.
        Current milestone = first ## with open - [ ] items. Create tickets
        only for that section. Pass-gate <!-- roadmap-pass:approved --> before
        next M{n}. Dedup <!-- roadmap:repo_id:… -->.
    - id: github-issue-check
      cron: "0 23 * * *"
      agents: [pm]
      prompt: >-
        Use factory-pm github-issue-check. Read .cursor/github-issues-registry.json
        (repos[] with client_id AND project_id only). New GH issues → that
        project tickets. Dedup <!-- github-issue:{repo_id}:{n} -->. Blockers
        add_comment. Actions/CD 실패 감시는 ta 소관. Empty registry → no-op.
    - id: rhwp-batch-upstream-check
      cron: "0 21 * * *"
      agents: [rhwp_batch]
      prompt: >-
        Use rhwp-upstream-sync. Check edwardkim/rhwp latest GitHub Release.
        If newer than vendored rhwp/: copy crate into rhwp/, test
        (cargo test -p rhwp-batch), git-ship PR. After merge, push the same
        version tag so .github/workflows/release.yml deploys. No new release
        and tag exists → no-op. Dedup <!-- rhwp-upstream:vX.Y.Z -->.
      success_checks:
        - Compared edwardkim/rhwp latest release tag to rhwp/Cargo.toml version.
        - No-op, or ticket+PR, or matching v* tag pushed (Action release).
        - Did not patch rhwp/ source (copy only). Did not force-push.
    - id: km-wiki
      cron: "30 23 * * *"
      agents: [km]
      prompt: >-
        Use km-researcher then knowledge-promote. Inbox drain + wiki ingest;
        commit·push directly to main. PR·git-ship 금지. 실패 New, 성공 Done 티켓.
    - id: candidate-escalation-drain
      cron: "0 2 * * *"
      agents: [candidate]
      prompt: >-
        Use candidate-escalation. After host Pass A (09:00 KST), drain
        workspaces/candidate/repos/candidate.win agent/.cache/escalation/pending.jsonl.
        Missing/empty pending → no-op (exit without writes unless a ticket was opened).
        Usable rows → wiki agent:stances → git-ship PR feature/escalation-drain-YYYYMMDD → @pm.
        Do not merge. Do not edit data/issues/*.yaml or <!-- human-edit -->.
      success_checks:
        - Pulled candidate.win ff-only (or reported blocker).
        - No-op with missing/empty pending, or PR opened with @pm + counts.
        - Did not merge; did not rewrite human-edit or data/issues SSoT.
    # 08:00 KST = 23:00 UTC (schedule:issue-radar-today-0800-kst)
    - id: issue-radar-today
      cron: "0 23 * * *"
      agents: [candidate]
      prompt: >-
        Use issue-radar-today. In candidate.win: git pull --ff-only main, then
        issue_radar.py run → publish_today.py → empty-overwrite guard → commit/push
        ONLY wiki/data/today.yaml. No Leantime write (--leantime is no-op; do not
        call create_leantime_report). Empty items must not overwrite a non-empty
        today.yaml (Publication-Gate). On success leave Done evidence on Active
        or open Done ticket with generated_at+SHA; on failure open/update New/Active
        with blocker. Cache/report MD are not commit scope.
      success_checks:
        - Ran radar then publish_today (or reported blocker with evidence).
        - today.yaml commit/push only when items non-empty or no overwrite risk; SHA noted.
        - No Leantime RPC/ticket writes; did not commit cache/report MD.
    - id: ta-k8s-daily
      cron: "0 1 * * *"
      agents: [ta]
      prompt: >-
        Use k8s-operator-operations. 일일 k8s 리포트(read-only). mutate/배포 금지.
        조치 가능 장애는 client 프로젝트 티켓.
    - id: ta-load-weekly
      cron: "0 2 * * 1"
      agents: [ta]
      prompt: >-
        Use tenant-repo-sync then load-weekly. Each clients-repos-registry
        entry: sync, run .factory/quality.yaml load against test. Failures →
        New ticket on that client project. Long-run: detach + nf-progress:.
    - id: aa-clean-weekly
      cron: "30 2 * * 1"
      agents: [aa]
      prompt: >-
        Use tenant-repo-sync then clean-code-weekly. High/Med → New tickets
        on client project. Not a prod gate. Long-run: detach + nf-progress:.
    - id: qa-bulk-weekly
      cron: "0 3 * * 1"
      agents: [qa]
      prompt: >-
        Use tenant-repo-sync then bulk-api-probe / opik-eval per tenant
        .factory/quality.yaml. Failures → New tickets. Long-run: nf-progress:.


prompts:
  ticket_created: "Ticket {ticket_id} created. Read via MCP then act. Active ticket_id={ticket_id}"
  ticket_updated: "Ticket {ticket_id} updated. Active ticket_id={ticket_id}"
  comment_added: "New comment on ticket {ticket_id}. Active ticket_id={ticket_id}"
  assignee_changed: "You are assignee of ticket {ticket_id}. Active ticket_id={ticket_id}"
  mention: "You were mentioned on ticket {ticket_id}. Active ticket_id={ticket_id}"
  handoff: "Handoff on ticket {ticket_id}. Active ticket_id={ticket_id}"
  catch_up: "Catch-up since {lookback_since}. Pick at most one actionable item; if none, exit without writes."

repos:
  - id: sw-factory
    git_repo_url: https://github.com/example/sw-factory.git
    client_id: "00000000-0000-0000-0000-000000000010"
    project_id: "00000000-0000-0000-0000-000000000012"
  - id: org-wiki
    git_repo_url: https://github.com/example/wiki.git
  - id: candidate.win
    git_repo_url: https://github.com/example/candidate.win.git
    client_id: "00000000-0000-0000-0000-000000000010"
    project_id: "00000000-0000-0000-0000-000000000013"

agents:
  - name: admin
    user_id: "00000000-0000-0000-0000-000000000001"
    email: admin@example.com
    persona: admin
    type: human

  - name: pm
    user_id: "00000000-0000-0000-0000-000000000002"
    email: pm@example.com
    persona: pm
    type: sessions
    workspace: /data/workspaces/pm
    roadmaps:
      - repo_id: sw-factory

  - name: km
    user_id: "00000000-0000-0000-0000-000000000003"
    email: km@example.com
    persona: km
    type: sessions
    workspace: /data/workspaces/km
    primary_repo: org-wiki

  - name: ta
    user_id: "00000000-0000-0000-0000-000000000004"
    email: ta@example.com
    persona: ta
    type: sessions
    workspace: /data/workspaces/ta
    repo_ids:
      - sw-factory
    # tenant_cd:
    #   - repo_id: nl2sql

  - name: qa
    user_id: "00000000-0000-0000-0000-000000000005"
    email: qa@example.com
    persona: qa
    type: sessions
    workspace: /data/workspaces/qa

  - name: aa
    user_id: "00000000-0000-0000-0000-000000000006"
    email: aa@example.com
    persona: aa
    type: sessions
    workspace: /data/workspaces/aa
    repo_ids:
      - sw-factory

  - name: sw-factory
    user_id: "00000000-0000-0000-0000-000000000007"
    email: sw-factory@example.com
    persona: sw-factory
    type: sessions
    workspace: /data/workspaces/sw-factory
    primary_repo: sw-factory

  - name: candidate
    user_id: "00000000-0000-0000-0000-000000000008"
    email: candidate@example.com
    persona: candidate
    type: sessions
    workspace: /data/workspaces/candidate
    primary_repo: candidate.win


