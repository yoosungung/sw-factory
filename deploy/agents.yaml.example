# Local / ConfigMap sample. Copy & edit user_id/email to match factory users.
# type: sessions — gateway delivery targets.
# repos[] catalog + agent primary_repo / repo_ids → seed ensure (clone-if-missing).

factory_base_url: https://factory.example.com

settings:
  model: auto
  debounce_ms: 2000
  pool_size: 2
  max_active_per_persona: 1
  max_queue_per_persona: 32
  cursor_listen: 127.0.0.1:8080
  poll_interval_ms: 3000

prompts:
  ticket_created: "Ticket {ticket_id} created. Read via MCP then act. Active ticket_id={ticket_id}"
  ticket_updated: "Ticket {ticket_id} updated. Active ticket_id={ticket_id}"
  comment_added: "New comment on ticket {ticket_id}. Active ticket_id={ticket_id}"
  assignee_changed: "You are assignee of ticket {ticket_id}. Active ticket_id={ticket_id}"
  mention: "You were mentioned on ticket {ticket_id}. Active ticket_id={ticket_id}"
  handoff: "Handoff on ticket {ticket_id}. Active ticket_id={ticket_id}"
  catch_up: "Catch-up since {lookback_since}. Pick at most one actionable item; if none, exit without writes."

repos:
  - id: sw-factory
    git_repo_url: https://github.com/example/sw-factory.git
  - id: nl2sql
    git_repo_url: https://github.com/example/nl2sql.git
  - id: org-wiki
    git_repo_url: https://github.com/example/wiki.git

agents:
  - name: admin
    user_id: "00000000-0000-0000-0000-000000000001"
    email: admin@example.com
    persona: admin
    type: human

  - name: pm
    user_id: "00000000-0000-0000-0000-000000000002"
    email: pm@example.com
    persona: pm
    type: sessions
    workspace: /data/workspaces/pm

  - name: km
    user_id: "00000000-0000-0000-0000-000000000003"
    email: km@example.com
    persona: km
    type: sessions
    workspace: /data/workspaces/km
    primary_repo: org-wiki

  - name: ta
    user_id: "00000000-0000-0000-0000-000000000004"
    email: ta@example.com
    persona: ta
    type: sessions
    workspace: /data/workspaces/ta
    repo_ids:
      - sw-factory
      - nl2sql

  - name: qa
    user_id: "00000000-0000-0000-0000-000000000005"
    email: qa@example.com
    persona: qa
    type: sessions
    workspace: /data/workspaces/qa

  - name: aa
    user_id: "00000000-0000-0000-0000-000000000006"
    email: aa@example.com
    persona: aa
    type: sessions
    workspace: /data/workspaces/aa
    repo_ids:
      - sw-factory
      - nl2sql

  - name: sw-factory
    user_id: "00000000-0000-0000-0000-000000000007"
    email: sw-factory@example.com
    persona: sw-factory
    type: sessions
    workspace: /data/workspaces/sw-factory
    primary_repo: sw-factory

  - name: nl2sql
    user_id: "00000000-0000-0000-0000-000000000008"
    email: nl2sql@example.com
    persona: nl2sql
    type: sessions
    workspace: /data/workspaces/nl2sql
    primary_repo: nl2sql
