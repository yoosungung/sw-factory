# Copy to .env (gitignored) and fill in. Used by run-local.sh / obtain-cookie.sh.

FACTORY_BASE_URL=https://factory.askwho.net

# Required: session cookie for GET /api/agent/events
# GATEWAY_SESSION_COOKIE=lt_session=…
# Or run: ./obtain-cookie.sh

FACTORY_LOGIN_EMAIL=
FACTORY_LOGIN_PASSWORD=

# Optional: real Cursor SDK. Empty → mock backend.
CURSOR_API_KEY=

# Force mock even if CURSOR_API_KEY is set
# AGENT_BACKEND=mock

# Persona workspace seed (./seed-personas.sh)
PERSONA_PASSWORD=
# Or per-persona: PERSONA_PASSWORD_PM=…

# Org-wiki (agent knowledge; not product SPA wiki)
# ORG_WIKI_URL=https://github.com/yoosungung/wiki.git

# GitHub token for seed ensureRepos (clone-if-missing). Also accepted: GITHUB_TOKEN.
# GH_TOKEN=

IMAGE=sw-factory-agent:local
CONTAINER_NAME=sw-factory-agent
