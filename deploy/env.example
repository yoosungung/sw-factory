# Copy to deploy/local/.env (gitignored). Used by run-local / obtain-cookie / seed / register.

FACTORY_BASE_URL=https://factory.askwho.net

# Gateway poll cookie (any registered user works for GET /api/agent/events)
GATEWAY_SESSION_COOKIE=
# Or: ./obtain-cookie.sh after FACTORY_LOGIN_*

# Login for obtain-cookie.sh (often a sessions bot email + PERSONA_PASSWORD)
FACTORY_LOGIN_EMAIL=
FACTORY_LOGIN_PASSWORD=

# Optional: real Cursor SDK. Empty → mock backend.
CURSOR_API_KEY=
# AGENT_BACKEND=mock

# Shared password for bot accounts (register-agent-users.sh + seed-personas.sh); >=8
PERSONA_PASSWORD=
# PERSONA_PASSWORD_PM=

# Org-wiki (agent knowledge; not product SPA wiki)
ORG_WIKI_URL=https://github.com/yoosungung/wiki.git

# GitHub token for ensureRepos (private HTTPS). Also: GITHUB_TOKEN
GH_TOKEN=

# Pod/local entrypoint: 1 = ensure repos on start
ENSURE_REPOS=1
# Apply /opt/persona-seed → /data/workspaces on start (Docker)
# APPLY_PERSONA_SEEDS=1
# PERSONA_SEED_DIR=/opt/persona-seed

# Paths (optional overrides)
# AGENTS_FILE=/absolute/path/to/deploy/agents.yaml
# DATA_HOST=/absolute/path/to/deploy/local/.local-data

IMAGE=sw-factory-agent:local
CONTAINER_NAME=sw-factory-agent
