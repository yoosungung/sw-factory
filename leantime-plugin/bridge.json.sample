{
  "debounce_ms": 3000,
  "mention_routing": true,
  "model": "auto",
  "agents": [
    {
      "name": "eric",
      "leantime_user_id": 1,
      "email": "eric@example.com",
      "runner_url": "",
      "git_repo_url": "https://github.com/demo-org/bridge-harness.git",
      "persona": "eric",
      "type": "human"
    },
    {
      "name": "pm",
      "leantime_user_id": 2,
      "email": "pm@example.com",
      "runner_url": "http://cursor-agent-pm.sw-factory.svc:8080",
      "git_repo_url": "https://github.com/demo-org/shop-api.git",
      "persona": "pm",
      "type": "sessions",
      "model": "auto"
    },
    {
      "name": "asky",
      "leantime_user_id": 101,
      "email": "asky@example.com",
      "runner_url": "http://cursor-agent-asky.sw-factory.svc:8080",
      "git_repo_url": "https://github.com/demo-org/landing-web.git",
      "persona": "asky",
      "type": "sessions",
      "model": "auto"
    },
    {
      "name": "path",
      "leantime_user_id": 102,
      "email": "path@example.com",
      "runner_url": "http://cursor-agent-path.sw-factory.svc:8080",
      "git_repo_url": "https://github.com/demo-org/topology-lib.git",
      "persona": "path",
      "type": "sessions",
      "model": "auto"
    },
    {
      "name": "ta",
      "leantime_user_id": 4,
      "email": "ta@example.com",
      "runner_url": "http://cursor-agent-ta.sw-factory.svc:8080",
      "git_repo_url": "https://github.com/demo-org/k8s-test.git",
      "persona": "ta",
      "type": "sessions",
      "model": "auto"
    },
    {
      "name": "km",
      "leantime_user_id": 3,
      "email": "km@example.com",
      "runner_url": "http://cursor-agent-km.sw-factory.svc:8080",
      "git_repo_url": "https://github.com/demo-org/org-wiki.git",
      "persona": "km",
      "type": "sessions",
      "model": "auto"
    },
    {
      "name": "qa",
      "leantime_user_id": 5,
      "email": "qa@example.com",
      "runner_url": "http://cursor-agent-qa.sw-factory.svc:8080",
      "git_repo_url": "https://github.com/demo-org/bridge-harness.git",
      "persona": "qa",
      "type": "sessions",
      "model": "auto"
    },
    {
      "name": "aa",
      "leantime_user_id": 6,
      "email": "aa@example.com",
      "runner_url": "http://cursor-agent-aa.sw-factory.svc:8080",
      "git_repo_url": "https://github.com/demo-org/bridge-harness.git",
      "persona": "aa",
      "type": "sessions",
      "model": "auto"
    }
  ],
  "prompts": {
    "ticket_created": "New ticket assigned. Use Leantime MCP: get_ticket + get_comments, then plan. When implementation is ready for review, follow git-ship (push + PR) before Leantime handoff.",
    "ticket_updated": "Ticket updated. Re-read context via MCP and continue or hand off with add_comment. Review handoff requires pushed commits and an open PR (git-ship skill).",
    "comment_added": "New comment on ticket. Read comments and respond with add_comment if needed.",
    "assignee_changed": "Assignee changed. If handing off for review: git-ship first (commit, push, PR), then add_comment with PR link and assign reviewer.",
    "mention": "You were @mentioned on ticket {ticket_id}. Read context and respond.",
    "handoff": "Assignee handoff. If work is ready for review: complete git-ship (push + PR), set ticket to Review, assign human reviewer, add_comment with PR link. Do not ask humans to push. Then stop until reassigned.",
    "catch_up": "Runner Ready catch-up (commute). No Active ticket_id — use agent-catch-up skill. Scan assigned open work and @mentions since {lookback_since}; pick ONE actionable item; start it in this session (MCP read/write on that ticket). If nothing actionable, exit quietly without ticket spam."
  },
  "status_prompts": {
    "4": "Status is In Progress. Continue implementation (local / developer).",
    "10": "Status is Review. Ensure commits are pushed and PR is open (git-ship). PM (pm) reviews/merges. After merge on tenant_cd: hand off to TA (ta) with merge_sha for Deploying Test.",
    "11": "Status is Deploying Test. TA runs tenant_cd with environment=test, leaves test_* evidence, then @qa and @aa and set status QA.",
    "12": "Status is QA. QA runs browser E2E; AA runs security-review (parallel). On both pass: hand off to TA for Deploying Prod. On fail: developer + In Progress.",
    "13": "Status is Deploying Prod. TA deploys environment=production, leaves prod_* evidence. PM marks Done only when feature evidence (test+qa+aa+prod) is complete.",
    "0": "Status is Done. Close out only when feature Done evidence is present: pr_url, merge_sha, test_*, qa: pass, aa: pass, prod_* (ARCHITECTURE §2.8). Merge alone is never Done for CD tickets.",
    "1": "Status is Blocked. Unblock or escalate to @eric / PM.",
    "2": "Status is Waiting for Approval. Await human decision (@eric); do not invent scope.",
    "3": "Status is New. PM intake / breakdown before In Progress."
  },
  "schedules": [
    {
      "id": "pm-checkpoint",
      "cron": "5,20,35,50 * * * *",
      "prompt": "Use the leantime-pm skill. Dual-loop flow checkpoint (ARCHITECTURE §2.6 #14). Scan In Progress + Review + Deploying Test + QA + Deploying Prod. In Progress: 30m timebox. Review: PM review/merge. Deploying*/QA stall ≥2h → re-@mention assignee only (no execute). Mentions: resolve each name via bridge.json leantime_user_id (never hardcode ids). ≤5 comments/run.",
      "agents": [
        "pm"
      ],
      "success_checks": [
        "At most 5 checkpoint comments added this run.",
        "No duplicate PM checkpoint within 30 minutes on the same ticket.",
        "Final reply lists acted/skipped tickets with classification."
      ],
      "gates": [
        "flow_active"
      ]
    },
    {
      "id": "github-issue-check",
      "cron": "0 23 * * *",
      "prompt": "github issue 점검하여 신규는 티켓으로 변환하고, 블로커가 있으면 add_comment 처리. QA가 재현·시나리오 등록할 수 있게 client 프로젝트에 둔다.",
      "success_checks": [
        "New GitHub issues are reflected as Leantime tickets or explicitly skipped with a comment.",
        "Blockers are reported via add_comment."
      ]
    },
    {
      "id": "km-wiki",
      "cron": "30 23 * * *",
      "prompt": "Use km-researcher then knowledge-promote as needed. Inbox drain + wiki research ingest; commit·push directly to default branch(main). PR·feature branch·git-ship 금지. 실패 시 ticket(New), 성공 시 ticket(Done).",
      "agents": [
        "km"
      ],
      "success_checks": [
        "Changes are committed and pushed directly to the default branch (no PR).",
        "Do not run git-ship or gh pr create.",
        "Inbox drain attempted (or explicitly no pending inbox).",
        "On success create/update a Done ticket; on failure a New ticket with blocker."
      ]
    },
    {
      "id": "ta-k8s-daily",
      "cron": "0 1 * * *",
      "prompt": "Use the k8s-operator-operations skill. 일일 k8s 운영 리포트(read-only). mutate/배포 금지. 조치 가능 장애는 incident-tickets.md대로 client 프로젝트 티켓.",
      "agents": [
        "ta"
      ],
      "success_checks": [
        "Report uses the k8s 운영 리포트 format with a clear status summary.",
        "No mutating kubectl actions in this scheduled run.",
        "Actionable incidents are ticketed or explicitly listed as none."
      ]
    },
    {
      "id": "ta-load-weekly",
      "cron": "0 2 * * 1",
      "prompt": "Use load-weekly skill. For each clients[] entry, run tenant .factory/quality.yaml load commands against test env. Failures → New ticket in that client's project_id. Do not mark feature tickets Done from this run.",
      "agents": [
        "ta"
      ],
      "success_checks": [
        "Each client load was run or explicitly skipped with reason.",
        "Failures created New tickets in the correct client project."
      ]
    },
    {
      "id": "aa-clean-weekly",
      "cron": "30 2 * * 1",
      "prompt": "Use clean-code-weekly skill. For each client repo, run tenant clean_code checks. Findings → New ticket in client project_id. Not a prod gate for feature tickets.",
      "agents": [
        "aa"
      ],
      "success_checks": [
        "Each client clean-code check ran or was skipped with reason.",
        "Findings filed as New tickets on the client project."
      ]
    },
    {
      "id": "qa-bulk-weekly",
      "cron": "0 3 * * 1",
      "prompt": "Use bulk-api-probe and opik-eval as configured in tenant .factory/quality.yaml. Weekly bulk quality across clients. Failures → New tickets on client project_id.",
      "agents": [
        "qa"
      ],
      "success_checks": [
        "Bulk/Opik suites ran per tenant config or skipped with reason.",
        "Failures filed as New tickets on the client project."
      ]
    }
  ],
  "success_checks": [
    "Read Active ticket via Leantime MCP before writing.",
    "Leave an add_comment outcome on the Active ticket.",
    "If Review-ready: git-ship (push + PR) before handoff.",
    "If tenant_cd-enabled: feature Done needs test+qa+aa+prod evidence (ARCHITECTURE §2.8).",
    "Wiki-first (org-knowledge); after work: inbox path or wiki: N/A on Active ticket."
  ],
  "budget": {
    "timeout_ms": 600000
  },
  "success_retry": {
    "max_attempts": 3
  }
}
